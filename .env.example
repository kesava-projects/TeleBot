# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# Telethon StringSession (REQUIRED for cloud deployments like Render)
# Generate this using: python generate_string_session.py
TELEGRAM_STRING_SESSION=your_generated_string_session_here

# Target contact: Set to "ALL" to reply to everyone, or specify IDs/usernames (e.g., "2029901529, @friend")
TARGET_CONTACT=ALL

# Auto-response message
AUTO_REPLY_MESSAGE=Hi, Harsha is currently busy. I am shan harsha's bot. How can I help you today?

# Optional: Cooldown in seconds per contact to prevent spam loops (default: 30)
COOLDOWN_SECONDS=30

# Optional: Local session name (default: user_session)
TELEGRAM_SESSION_NAME=user_session
